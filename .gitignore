# Private data must never be tracked.
data/private/

# Local Python virtual environment.
.venv/

# Python caches / build artifacts.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Local secrets / env files must never be tracked.
.env
.env.*
*.key
.streamlit/secrets.toml

# PaperQA2 local runtime state. Indexes are large and regenerable, so only they are
# ignored; .pqa/settings/*.json holds the tracked baseline run configuration.
.pqa/indexes/
.pqa/cache/
pqa_index/

# OS noise.
.DS_Store
Thumbs.db
